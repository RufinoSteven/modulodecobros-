<settings xmlns="http://maven.apache.org/SETTINGS/1.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 https://maven.apache.org/xsd/settings-1.1.0.xsd">
    <servers>
        <server>
            <id>commons-data</id>
            <username>${env.MAVEN_USERNAME_COMMONS_DATA}</username>
            <password>${env.MAVEN_PASSWORD_COMMONS_DATA}</password>
        </server>
        <server>
            <id>connexusdb</id>
            <username>${env.MAVEN_USERNAME_CONNEXUSDB}</username>
            <password>${env.MAVEN_PASSWORD_CONNEXUSDB}</password>
        </server>
        <server>
            <id>connexusdb-gui</id>
            <username>${env.MAVEN_USERNAME_CONNEXUSDB_GUI}</username>
            <password>${env.MAVEN_PASSWORD_CONNEXUSDB_GUI}</password>
        </server>
        <server>
            <id>connexusdb-maven-plugin</id>
            <username>${env.MAVEN_USERNAME_CONNEXUSDB_PLUGIN}</username>
            <password>${env.MAVEN_PASSWORD_CONNEXUSDB_PLUGIN}</password>
        </server>
    </servers>
    <pluginGroups>
        <pluginGroup>com.banreservas</pluginGroup>
    </pluginGroups>
</settings>
